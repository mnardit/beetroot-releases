<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>beetroot</id>
    <version>1.6.6</version>
    <title>Beetroot</title>
    <authors>MNardit</authors>
    <owners>MNardit</owners>
    <projectUrl>https://github.com/mnardit/beetroot-releases</projectUrl>
    <licenseUrl>https://github.com/mnardit/beetroot-releases/blob/4fcfbfbbaf6aa9a4e864331faffc51b3b15c5c9e/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Lightweight clipboard manager for Windows with AI-powered text transforms.

Features:
- Unlimited clipboard history (text and images)
- Global hotkey (Ctrl+`) to instantly access history
- Fuzzy and regex search
- AI-powered text transforms (OpenAI, Anthropic, Google, Ollama/Local LLM)
- System-wide "Copied" overlay (customizable position, duration, 6 exit animations)
- No-focus window mode (type anywhere while browsing history)
- Preview panel with 3 content modes (text, code with line numbers, image with zoom)
- OCR text extraction from images
- Notes on clipboard items
- Multi-select batch operations
- 9 themes + custom accent color + window effects
- 26 languages
- Plain text paste hotkey
- Non-QWERTY keyboard support (AZERTY, QWERTZ, AltGr)
    </description>
    <summary>Modern clipboard manager for Windows</summary>
    <tags>clipboard clipboard-manager productivity tauri windows beetroot</tags>
    <packageSourceUrl>https://github.com/mnardit/beetroot-releases</packageSourceUrl>
    <docsUrl>https://github.com/mnardit/beetroot-releases/blob/main/README.md</docsUrl>
    <bugTrackerUrl>https://github.com/mnardit/beetroot-releases/issues</bugTrackerUrl>
    <iconUrl>https://raw.githubusercontent.com/mnardit/beetroot-releases/main/icons/icon.png</iconUrl>
    <releaseNotes>https://github.com/mnardit/beetroot-releases/releases/tag/v1.6.6</releaseNotes>
    <dependencies>
      <dependency id="webview2-runtime" />
    </dependencies>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
